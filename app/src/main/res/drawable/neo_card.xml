<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="@dimen/hard_shadow_offset" android:top="@dimen/hard_shadow_offset">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink_shadow" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
    <item android:bottom="@dimen/hard_shadow_offset" android:right="@dimen/hard_shadow_offset">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_surface" />
            <stroke
                android:width="@dimen/border_width"
                android:color="@color/ink_border" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
</layer-list>